# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
test-results/
playwright-report/
playwright/.cache/

# turborepo
.turbo/

# 카탈로그 이미지 복사본 (원본은 packages/domain/assets, 앱의 dev·build 스크립트가 복사)
apps/*/public/images/games/
apps/*/public/images/game-placeholder.png

# IDE 설정
.idea/
!.env.example
!.env.development

# PGlite 개발 DB (pnpm --filter @avocado/admin db:reset으로 지우고 다시 만든다)
.data/

# Playwright 로그인 상태 (e2e/auth.setup.ts가 매번 만든다)
apps/admin/e2e/.auth/
