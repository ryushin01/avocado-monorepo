# 운영(또는 next start)에 필요한 값
# PostgreSQL 연결 주소. 없으면 PGlite(.data/pglite)를 쓴다.
DATABASE_URL=postgres://user:password@host:5432/avocado
# 로그인(Auth.js): 서비스 주소와 서명 키 (openssl rand -base64 32)
NEXTAUTH_URL=https://admin.example.com
NEXTAUTH_SECRET=
# 키오스크 API 토큰. 런처에도 같은 값을 설정한다.
KIOSK_API_TOKEN=
# 운영 DB가 비어 있을 때 개발용 시드(가상 매장·직원)를 넣으려면 1
SEED_DEMO=
