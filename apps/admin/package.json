{
  "name": "@avocado/admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "copy-catalog-assets public && next dev --port 3000",
    "build": "copy-catalog-assets public && next build",
    "start": "next start --port 3000",
    "lint": "eslint",
    "typecheck": "next typegen && tsc7 --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "create-admin": "tsx scripts/create-admin.ts",
    "db:reset": "node -e \"require('fs').rmSync('.data/pglite',{recursive:true,force:true})\" && echo \"개발 DB를 지웠습니다. 다음 실행 때 시드로 다시 만듭니다.\""
  },
  "dependencies": {
    "@avocado/config": "workspace:*",
    "@avocado/domain": "workspace:*",
    "@avocado/logger": "workspace:*",
    "@avocado/ui": "workspace:*",
    "@electric-sql/pglite": "0.5.15",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.67.0",
    "next": "16.4.5",
    "next-auth": "4.24.15",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
