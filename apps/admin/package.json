{
  "name": "@avocado/admin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "copy-catalog-assets public && next dev --port 3000",
    "build": "copy-catalog-assets public && next build",
    "start": "next start --port 3000",
    "preview": "NEXTAUTH_URL=http://localhost:3000 NEXTAUTH_SECRET=local-preview-only-not-secret PGLITE_DATA_DIR=memory:// SEED_DEMO=1 BOOKING_API_TOKEN=local-preview-booking next start --port 3000",
    "lint": "eslint && steiger ./src",
    "typecheck": "next typegen && tsc7 --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test --project=screenshots",
    "db:generate": "drizzle-kit generate",
    "create-admin": "tsx scripts/create-admin.ts",
    "db:prune": "tsx scripts/prune.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore.ts",
    "db:reset": "node -e \"require('fs').rmSync('.data/pglite',{recursive:true,force:true})\" && echo \"개발 DB를 지웠습니다. 다음 실행 때 시드로 다시 만듭니다.\""
  },
  "dependencies": {
    "@avocado/config": "workspace:*",
    "@avocado/domain": "workspace:*",
    "@avocado/logger": "workspace:*",
    "@avocado/monitoring": "workspace:*",
    "@avocado/ui": "workspace:*",
    "@electric-sql/pglite": "0.5.16",
    "@sentry/nextjs": "^11.14.0",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "geist": "^1.9.2",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite-tools": "0.4.16",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@playwright/test": "^1.65.1",
    "@storybook/nextjs-vite": "10.6.7",
    "@tailwindcss/turbopack": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "gifenc": "^1.0.3",
    "jsdom": "^31.0.1",
    "steiger": "0.10.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
