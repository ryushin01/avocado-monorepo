{
  "name": "@avocado/launcher",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "copy-catalog-assets public && next dev --port 3001",
    "build": "copy-catalog-assets public && next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@avocado/domain": "workspace:*",
    "@avocado/logger": "workspace:*",
    "@avocado/ui": "workspace:*",
    "lucide-react": "^1.67.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@avocado/config": "workspace:*",
    "@tailwindcss/turbopack": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
