{
  "name": "@avocado/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "copy-catalog-assets public && next dev --port 3002",
    "build": "copy-catalog-assets public && next build",
    "start": "next start --port 3002",
    "preview": "BACKOFFICE_URL=http://localhost:3000 BOOKING_API_TOKEN=local-preview-booking next start --port 3002",
    "lint": "eslint && steiger ./src",
    "typecheck": "next typegen && tsc7 --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "import:avocado-media": "node scripts/import-avocado-media.mjs",
    "size": "size-limit",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@avocado/config": "workspace:*",
    "@avocado/domain": "workspace:*",
    "@avocado/logger": "workspace:*",
    "@avocado/monitoring": "workspace:*",
    "@avocado/ui": "workspace:*",
    "@fontsource-variable/comfortaa": "^5.3.0",
    "@fontsource/gowun-dodum": "^5.3.0",
    "@sentry/nextjs": "^11.13.0",
    "embla-carousel-autoplay": "^8.6.0",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "posthog-js": "1.450.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@storybook/nextjs-vite": "10.6.7",
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "sharp": "^0.35.5",
    "steiger": "0.10.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
