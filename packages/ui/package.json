{
  "name": "@avocado/ui",
  "version": "1.2.3",
  "private": true,
  "type": "module",
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./styles.css": "./src/styles/globals.css"
  },
  "scripts": {
    "typecheck": "tsc7 --noEmit",
    "lint": "eslint",
    "test": "node --test \"scripts/*.test.mjs\"",
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build --output-dir storybook-static --quiet",
    "test:stories": "node scripts/check-stories-a11y.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.74.0",
    "react-is": "19.3.1",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "next": ">=16.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@avocado/config": "workspace:*",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/nextjs-vite": "10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "next": "16.4.6",
    "shadcn": "^4.23.0",
    "storybook": "10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  }
}
