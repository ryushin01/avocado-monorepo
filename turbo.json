{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!e2e/**"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "BACKOFFICE_URL",
        "LAUNCHER_CAFE_ID",
        "KIOSK_API_TOKEN"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "lint": {},
    "test": {},
    "test:coverage": {
      "outputs": [
        "coverage/**"
      ]
    },
    "e2e": {
      "cache": false,
      "passThroughEnv": [
        "CI"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "BACKOFFICE_URL",
        "LAUNCHER_CAFE_ID",
        "KIOSK_API_TOKEN",
        "DATABASE_URL",
        "PGLITE_DATA_DIR",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "SEED_DEMO"
      ]
    }
  }
}
